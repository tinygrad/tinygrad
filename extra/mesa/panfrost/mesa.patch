+   unsigned bit_size = intr->def.bit_size;
+   unsigned idx = bit_size >> 4;
+   SpvId scalar_type = get_uvec_type(ctx, bit_size, 1);
+   if (!ctx->ubos[0][idx]) {
+      SpvId array_type = spirv_builder_type_runtime_array(&ctx->builder, scalar_type);
+      SpvId struct_type = spirv_builder_type_struct(&ctx->builder, &array_type, 1);
+      spirv_builder_emit_decoration(&ctx->builder, struct_type, SpvDecorationBlock);
+      spirv_builder_emit_member_offset(&ctx->builder, struct_type, 0, 0);
+      SpvId pointer_type = spirv_builder_type_pointer(&ctx->builder,
+                                                       SpvStorageClassUniform,
+                                                       struct_type);
+      SpvId var_id = spirv_builder_emit_var(&ctx->builder, pointer_type,
+                                            SpvStorageClassUniform);
+      spirv_builder_emit_descriptor_set(&ctx->builder, var_id, 0);
+      spirv_builder_emit_binding(&ctx->builder, var_id, 0);
+      ctx->ubos[0][idx] = var_id;
+   }
+
+   nir_alu_type atype;
+   SpvId offset = get_src(ctx, &intr->src[1], &atype);
+   SpvId uint_type = get_uvec_type(ctx, 32, 1);
+   if (atype != nir_type_uint)
