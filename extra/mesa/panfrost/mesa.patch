+      spirv_builder_emit_composite_construct(&ctx->builder,
+                                             get_def_uvec_type(ctx, &intr->def),
+                                             constituents,
+                                             intr->def.num_components);
+   store_def(ctx, intr->def.index, result, nir_type_uint);
