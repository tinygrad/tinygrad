+   SpvId element = emit_binop(ctx, SpvOpUDiv, uint_type, offset,
+                              emit_uint_const(ctx, 32, bit_size / 8));
+   SpvId zero = emit_uint_const(ctx, 32, 0);
+   SpvId pointer_type = spirv_builder_type_pointer(&ctx->builder,
+                                                    SpvStorageClassUniform,
+                                                    scalar_type);
+   SpvId constituents[NIR_MAX_VEC_COMPONENTS];
+   for (unsigned i = 0; i < intr->def.num_components; ++i) {
+      SpvId indices[2] = { zero, element };
+      SpvId ptr = spirv_builder_emit_access_chain(&ctx->builder, pointer_type,
+                                                  ctx->ubos[0][idx], indices,
+                                                  ARRAY_SIZE(indices));
+      constituents[i] = spirv_builder_emit_load(&ctx->builder, scalar_type, ptr);
+      if (i + 1 < intr->def.num_components)
