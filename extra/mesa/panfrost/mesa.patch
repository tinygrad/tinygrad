+struct pipe_resource *
+panfrost_resource_lookup(struct pipe_screen *screen, uint64_t address)
+{
+   simple_mtx_lock(&pan_screen(screen)->resources_mutex);
+   struct pipe_resource *ret = NULL;
+   for (struct panfrost_resource *r = pan_screen(screen)->resources; r; r = r->next_resource) {
+      if (address >= r->plane.base && address < r->plane.base + r->base.width0) {
+         ret = &r->base;
+         break;
+      }
+   }
+   simple_mtx_unlock(&pan_screen(screen)->resources_mutex);
+   return ret;
+}
