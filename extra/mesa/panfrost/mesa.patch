+
+/* Small public Gallium entry points used by the tinymesa HCQ runtime. */
+uint64_t
+panfrost_resource_address(struct pipe_resource *resource)
+{
+   return pan_resource(resource)->plane.base;
+}
+
+struct pipe_context *
+panfrost_compute_bind(struct pipe_context *ctx, void *state)
+{
+   ctx->bind_compute_state(ctx, state);
+   return ctx;
+}
+
+struct pipe_context *
+panfrost_compute_set_constants(struct pipe_context *ctx,
+                               const struct pipe_constant_buffer *cb,
+                               void *args)
+{
+   ((struct pipe_constant_buffer *)cb)->user_buffer = args;
+   ctx->set_constant_buffer(ctx, PIPE_SHADER_COMPUTE, 0, false, cb);
+   return ctx;
+}
+
+struct pipe_context *
+panfrost_compute_launch(struct pipe_context *ctx,
+                        const struct pipe_grid_info *grid)
+{
+   ctx->launch_grid(ctx, grid);
+   return ctx;
+}
+
+void *
+panfrost_compute_create_sampler_view(struct pipe_context *ctx,
+                                     uint64_t address,
+                                     const struct pipe_sampler_view *tmpl)
+{
+   struct pipe_resource *resource = panfrost_resource_lookup(ctx->screen, address);
+   return ctx->create_sampler_view(ctx, resource, tmpl);
+}
+
+struct pipe_context *
+panfrost_compute_set_samplers(struct pipe_context *ctx, void *sampler,
+                              struct pipe_sampler_view **views, unsigned count)
+{
+   ctx->bind_sampler_states(ctx, PIPE_SHADER_COMPUTE, 0, 1, &sampler);
+   ctx->set_sampler_views(ctx, PIPE_SHADER_COMPUTE, 0, count, 0, views);
+   return ctx;
+}
+
+struct pipe_context *
+panfrost_compute_release_sampler_view(struct pipe_context *ctx,
+                                      struct pipe_sampler_view *view)
+{
+   ctx->sampler_view_release(ctx, view);
+   return ctx;
+}
+
+struct pipe_context *
+panfrost_compute_set_images(struct pipe_context *ctx, unsigned count,
+                            const struct pipe_image_view *views,
+                            uint64_t address0, uint64_t address1,
+                            uint64_t address2, uint64_t address3)
+{
+   uint64_t addresses[] = {address0, address1, address2, address3};
+   struct pipe_image_view resolved[4];
+   assert(count <= 4);
+   memcpy(resolved, views, count * sizeof(*views));
+   for (unsigned i = 0; i < count; i++)
+      resolved[i].resource = panfrost_resource_lookup(ctx->screen, addresses[i]);
+   ctx->set_shader_images(ctx, PIPE_SHADER_COMPUTE, 0, count, 0, resolved);
+   return ctx;
+}
+
+struct pipe_context *
+panfrost_compute_flush(struct pipe_context *ctx)
+{
+   ctx->flush(ctx, NULL, 0);
+   return ctx;
+}
+
+
+struct pipe_context *
+panfrost_buffer_write(struct pipe_context *ctx, uint64_t address,
+                      const void *data, unsigned size)
+{
+   struct pipe_resource *resource = panfrost_resource_lookup(ctx->screen, address);
+   struct pipe_box box = {.width = size, .height = 1, .depth = 1};
+   box.x = address - pan_resource(resource)->plane.base;
+   struct pipe_transfer *transfer;
+   void *ptr = ctx->buffer_map(ctx, resource, 0, PIPE_MAP_WRITE, &box, &transfer);
+   memcpy(ptr, data, size);
+   ctx->buffer_unmap(ctx, transfer);
+   return ctx;
+}
+
+struct pipe_context *
+panfrost_buffer_read(struct pipe_context *ctx, uint64_t address,
+                     void *data, unsigned size)
+{
+   struct pipe_resource *resource = panfrost_resource_lookup(ctx->screen, address);
+   struct pipe_fence_handle *fence = NULL;
+   ctx->flush(ctx, &fence, 0);
+   if (fence) {
+      ctx->screen->fence_finish(ctx->screen, NULL, fence, OS_TIMEOUT_INFINITE);
+      ctx->screen->fence_reference(ctx->screen, &fence, NULL);
+   }
+   struct pipe_box box = {.width = size, .height = 1, .depth = 1};
+   box.x = address - pan_resource(resource)->plane.base;
+   struct pipe_transfer *transfer;
+   void *ptr = ctx->buffer_map(ctx, resource, 0, PIPE_MAP_READ, &box, &transfer);
+   memcpy(data, ptr, size);
+   ctx->buffer_unmap(ctx, transfer);
+   return ctx;
+}
+
+struct pipe_context *
+panfrost_buffer_copy(struct pipe_context *ctx, uint64_t dst_address,
+                     uint64_t src_address, unsigned size)
+{
+   struct pipe_resource *dst = panfrost_resource_lookup(ctx->screen, dst_address);
+   struct pipe_resource *src = panfrost_resource_lookup(ctx->screen, src_address);
+   if (!dst && !src) {
+      memcpy((void *)dst_address, (void *)src_address, size);
+      return ctx;
+   }
+   if (!src) {
+         return panfrost_buffer_write(ctx, dst_address, (const void *)src_address, size);
+   }
+   if (!dst) {
+      return panfrost_buffer_read(ctx, src_address, (void *)dst_address, size);
+   }
+   struct pipe_box box = {.x = src_address - pan_resource(src)->plane.base,
+                          .width = size, .height = 1, .depth = 1};
+   ctx->resource_copy_region(ctx, dst, 0, dst_address - pan_resource(dst)->plane.base,
+                             0, 0, src, 0, &box);
+   return ctx;
+}
+
+
+struct pipe_context *
+panfrost_compute_wait(struct pipe_context *ctx, volatile uint64_t *address,
+                      uint64_t value)
+{
+   while (*address < value)
+      ;
+   return ctx;
+}
+
+struct pipe_context *
+panfrost_compute_signal(struct pipe_context *ctx, uint64_t *address,
+                        uint64_t value)
+{
+   *address = value;
+   return ctx;
+}
+
+
+struct pipe_context *
+panfrost_compute_timestamp(struct pipe_context *ctx, uint64_t *address)
+{
+   struct pipe_fence_handle *fence = NULL;
+   ctx->flush(ctx, &fence, 0);
+   if (fence) {
+      ctx->screen->fence_finish(ctx->screen, NULL, fence, OS_TIMEOUT_INFINITE);
+      ctx->screen->fence_reference(ctx->screen, &fence, NULL);
+   }
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   *address = ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+   return ctx;
+}
